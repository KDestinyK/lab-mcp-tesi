      }
    },
    {
      "id": "origin_null",
      "tipo": "limite",
      "descrizione": "Origin 'null' (iframe in sandbox, file locali), non tra quelle ammesse dalla 1.23.0.",
      "comando": [
        "-sS",
        "-i",
        "-v",
        "-X",
        "POST",
        "http://127.0.0.1:8000/mcp",
        "-H",
        "Content-Type: application/json",
        "-H",
        "Accept: application/json, text/event-stream",
        "-H",
        "Origin: null",
        "-d",
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"registra_esecuzione\",\"arguments\":{\"caso\":\"{caso}\"}}}",
        "-w",
        "\n%{http_code}\n"
      ],
      "verifica": {
        "servizio": "target",
        "comando": [
          "python",
          "/app/verifica.py",
          "{caso}"
        ]
      },
      "atteso": {
        "vulnerabile": "accettata",
        "corretta": "respinta"
      }
    }
  ]
}
