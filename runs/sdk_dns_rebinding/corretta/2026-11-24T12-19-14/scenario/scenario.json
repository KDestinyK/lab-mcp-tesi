        "-d",
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"registra_esecuzione\",\"arguments\":{\"caso\":\"{caso}\"}}}",
        "-w",
        "\n%{http_code}\n"
      ],
      "verifica": {
        "servizio": "target",
        "comando": [
          "python",
          "/app/verifica.py",
          "{caso}"
        ]
      },
      "atteso": {
        "vulnerabile": "accettata",
